# Copy to .env and adjust as needed. Never commit the real .env file.

API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000"]

DEFAULT_REQUEST_DELAY_SECONDS=1.0
DEFAULT_TIMEOUT_SECONDS=15.0
DEFAULT_MAX_RETRIES=3

LOG_LEVEL=INFO

# Google Sheets -- REQUIRED. This service has no database; the product
# catalog and the New_brand/System_Config/Sync_logs admin sheets all live in
# this one spreadsheet (see README.md). Download a service-account JSON key
# from Google Cloud Console, save it as
# credentials/google-service-account.json (gitignored -- never commit it),
# and share the target spreadsheet with that service account's client_email
# as an Editor.
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials/google-service-account.json
GOOGLE_SPREADSHEET_ID=

# AI-assisted generic adapter (optional). Powers "request a new manufacturer"
# -> preview/approve for manufacturers with no hand-written adapter. Needs a
# local Ollama server (https://ollama.com) with OLLAMA_MODEL pulled.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
