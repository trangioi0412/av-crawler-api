# Copy to .env and adjust as needed. Never commit the real .env file.

# SQLite by default (zero setup). Point at Postgres/MySQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/datacrawler
DATABASE_URL=sqlite:///./data/sync.db

API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000"]

DEFAULT_REQUEST_DELAY_SECONDS=1.0
DEFAULT_TIMEOUT_SECONDS=15.0
DEFAULT_MAX_RETRIES=3

LOG_LEVEL=INFO

# Google Sheets export (optional). Download a service-account JSON key from
# Google Cloud Console, save it as credentials/google-service-account.json
# (gitignored -- never commit it), and share the target spreadsheet with
# that service account's client_email as an Editor.
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials/google-service-account.json
GOOGLE_SPREADSHEET_ID=

# AI-assisted generic adapter (optional). Powers "request a new manufacturer"
# -> preview/approve for manufacturers with no hand-written adapter. Needs a
# local Ollama server (https://ollama.com) with OLLAMA_MODEL pulled.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
